{
  "openapi": "3.1.0",
  "info": {
    "title": "Toolweather API (suite)",
    "version": "1.2.0",
    "description": "Toolweather suite: is this MCP server healthy and safe to call right now? Live health verdicts for ~2,000 public MCP servers from the official registry, checked every 15 minutes, plus working alternatives. The same MCP endpoint also exposes Upstream tools (check_api_status, check_model_deprecation, list_recent_api_changes, list_providers, get_digest) for AI/dev API status and model deprecations; Upstream's own REST/x402 API remains at https://upstream.toolweather.workers.dev. Free tier: 1,000 calls/day per key; get a key instantly with POST /v1/keys (no email or signup). Change alerts: watch up to 3 servers per free key and receive signed HTTPS webhooks. Python urllib users: Cloudflare returns HTTP 403 'error code: 1010' for the default Python-urllib User-Agent; send any other User-Agent header. Pricing: free 1,000 calls/day per key and 3 watches; over quota, HTTP 402 x402 v2 exact (USDC on Base): $0.002/check, $0.005/live recheck, $0.02/batch of 25, $0.05 per extra watch per 30 days. See /v1/pricing.",
    "contact": {
      "email": "toolweather@mail.grokbot.com",
      "url": "https://toolweather.pages.dev"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "x-pricing": {
      "free": {
        "calls_per_day_per_key": 1000,
        "live_rechecks_per_day": 200,
        "watches": 3
      },
      "x402": {
        "network": "eip155:8453",
        "asset": "USDC",
        "pay_to": "0xb9D9af3Bf4C352fF4e6D3cf480bFc31CB832Ce29",
        "prices_usd": {
          "check": 0.002,
          "live": 0.005,
          "alternatives": 0.002,
          "batch": 0.02,
          "watch_30d": 0.05
        }
      },
      "details": "https://toolweather.toolweather.workers.dev/v1/pricing"
    },
    "x-guidance": "Free: get a key with POST /v1/keys (1,000 calls/day). Pay-only lanes need no key: POST /x402/is_safe_to_call {server, tool?} ($0.002), POST /x402/live_check {server} ($0.005), POST /x402/suggest_alternatives {q} ($0.002), POST /x402/batch_check {servers:[...]} ($0.02). GET with query parameters works too."
  },
  "servers": [
    {
      "url": "https://toolweather.toolweather.workers.dev"
    }
  ],
  "externalDocs": {
    "url": "https://github.com/toolweather/toolweather"
  },
  "security": [
    {
      "apiKeyHeader": []
    },
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Verdict": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "safe",
              "caution",
              "unsafe",
              "unknown"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "auth_required",
              "failed"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "latency_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "protocol_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "spec_readiness": {
            "type": "object"
          },
          "auth": {
            "type": [
              "object",
              "null"
            ]
          },
          "tool_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "last_tool_change": {
            "type": [
              "object",
              "null"
            ]
          },
          "last_checked": {
            "type": "string",
            "format": "date-time"
          },
          "other_endpoints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the data behind this verdict was checked (live handshake or scheduled probe)"
          },
          "age_seconds": {
            "type": "integer",
            "description": "Seconds since checked_at"
          },
          "source": {
            "type": "string",
            "enum": [
              "scheduled_probe",
              "live_probe",
              "live_cache"
            ]
          },
          "live": {
            "type": "object",
            "nullable": true,
            "description": "Result of the inline initialize handshake, when one was used",
            "properties": {
              "status": {
                "type": "string"
              },
              "http_status": {
                "type": "integer",
                "nullable": true
              },
              "latency_ms": {
                "type": "number"
              },
              "protocol_version": {
                "type": "string",
                "nullable": true
              },
              "error": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "live_check": {
            "type": "string",
            "description": "Present when a live check was not possible (e.g. SSE transport, per-key limit)"
          }
        },
        "required": [
          "verdict",
          "reasons"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Watch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "server": {
            "type": "string"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "active": {
            "type": "boolean"
          },
          "disabled_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "last_known": {
            "type": "object"
          },
          "consecutive_failures": {
            "type": "integer"
          },
          "last_delivery": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "description": "POSTed to webhook_url. Verify X-Toolweather-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, t + '.' + raw_body)>. Headers also include X-Toolweather-Event and X-Toolweather-Delivery. Respond 2xx within 10 s; failures retry after 1, 5, 30, 120 and 360 minutes; a watch is disabled after 3 failed deliveries.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "verdict_changed",
              "auth_required",
              "breaking_tool_change"
            ]
          },
          "watch_id": {
            "type": "string"
          },
          "created": {
            "type": "string"
          },
          "server": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "previous": {
            "type": "object"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "last_checked": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/is_safe_to_call": {
      "get": {
        "operationId": "isSafeToCall",
        "summary": "Is this MCP server (or tool) healthy and safe to call right now?",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "required": true,
            "description": "Registry name (e.g. io.github.owner/name) or server URL",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tool",
            "in": "query",
            "required": false,
            "description": "Tool name to check against the current tool list",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fresh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Force a live read-only handshake now. Without it, a live handshake runs automatically when the stored check is older than 5 minutes. Live results are cached ~1-5 min; 200 live checks per key per day."
          },
          {
            "name": "X-Upstream-Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional 'Bearer <token>' for the target server: one-off authenticated initialize + tools/list check, returned as authenticated_check. Never stored or logged."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verdict"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Free daily limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Cloudflare edge block (body 'error code: 1010') for the default Python-urllib User-Agent. Not generated by Toolweather; set a User-Agent header."
          },
          "402": {
            "description": "Free quota used up, or pay-only lane: x402 v2 payment required. PAYMENT-REQUIRED header (base64) and a JSON body with accepts[]. Retry with PAYMENT-SIGNATURE."
          }
        },
        "description": "Use before adding/calling a third-party MCP server or after its calls fail. Response starts with summary (one line), verdict (safe|caution|unsafe|unknown), recommended_action (call_it|call_with_care|use_alternative|verify_yourself), checked_at and freshness; all previous fields are kept. MCP tool: check_mcp_server_health (alias is_safe_to_call).",
        "x-price-over-free-tier": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.002000"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
    "/v1/suggest_alternatives": {
      "get": {
        "operationId": "suggestAlternatives",
        "summary": "Find a working MCP server that does X, or a replacement for a broken one",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Server name/URL, or capability text like 'send email'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string"
                    },
                    "alternatives": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "server": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "verdict": {
                            "type": "string"
                          },
                          "latency_ms": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "relevance": {
                            "type": "number"
                          },
                          "matching_tools": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "last_checked": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Free daily limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Free quota used up, or pay-only lane: x402 v2 payment required. PAYMENT-REQUIRED header (base64) and a JSON body with accepts[]. Retry with PAYMENT-SIGNATURE."
          }
        },
        "description": "Response starts with a one-line summary and checked_at, then ranked healthy servers. MCP tool: find_alternative_mcp_servers (alias suggest_alternatives).",
        "x-price-over-free-tier": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.002000"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Service health and last data ingest time",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "last_ingest": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/badge/{name}.svg": {
      "get": {
        "operationId": "badge",
        "summary": "SVG status badge for a server",
        "security": [],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SVG badge",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/watches": {
      "post": {
        "operationId": "watch_server",
        "summary": "Watch a server; get an HTTPS webhook on verdict change, new auth requirement, or breaking tool change",
        "security": [
          {
            "apiKeyHeader": []
          },
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server",
                  "webhook_url"
                ],
                "properties": {
                  "server": {
                    "type": "string",
                    "description": "registry name or URL"
                  },
                  "webhook_url": {
                    "type": "string",
                    "description": "public https URL (private/loopback addresses rejected)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created. Includes the per-watch `secret` (shown once).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Watch"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "secret": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or webhook_url",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Free-tier limit (3 watches per key) reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Server not indexed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Free quota used up, or pay-only lane: x402 v2 payment required. PAYMENT-REQUIRED header (base64) and a JSON body with accepts[]. Retry with PAYMENT-SIGNATURE."
          }
        },
        "callbacks": {
          "change": {
            "{$request.body#/webhook_url}": {
              "post": {
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/WebhookEvent"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Acknowledged"
                  }
                }
              }
            }
          }
        },
        "x-price-over-free-tier": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.050000"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      },
      "get": {
        "operationId": "list_watches",
        "summary": "List this key's watches",
        "security": [
          {
            "apiKeyHeader": []
          },
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Watches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "watches": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Watch"
                      }
                    },
                    "free_tier": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Free quota used up, or pay-only lane: x402 v2 payment required. PAYMENT-REQUIRED header (base64) and a JSON body with accepts[]. Retry with PAYMENT-SIGNATURE."
          }
        }
      }
    },
    "/v1/watches/{id}": {
      "delete": {
        "operationId": "unwatch_server",
        "summary": "Delete a watch",
        "security": [
          {
            "apiKeyHeader": []
          },
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/keys": {
      "post": {
        "operationId": "get_api_key",
        "summary": "Create a free API key instantly (no auth). The key is returned once.",
        "security": [],
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "rest",
                "web"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "api_key": {
                      "type": "string"
                    },
                    "daily_limit": {
                      "type": "integer"
                    },
                    "watches_limit": {
                      "type": "integer"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Per-network or global daily key-creation limit reached; retry tomorrow (UTC)"
          }
        }
      }
    },
    "/v1/accuracy": {
      "get": {
        "operationId": "get_accuracy",
        "summary": "Public track record: daily share of verdicts that matched the next scheduled probe of the same server (no key needed)",
        "security": [],
        "responses": {
          "200": {
            "description": "Daily and total match rates per verdict class, with definition and limitations"
          }
        }
      }
    },
    "/v1/batch_check": {
      "post": {
        "operationId": "batch_check",
        "summary": "Health verdicts for up to 25 MCP servers (each counts as 1 free call; over quota $0.02 per batch via x402)",
        "security": [
          {
            "apiKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "servers"
                ],
                "properties": {
                  "servers": {
                    "type": "array",
                    "maxItems": 25,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "string"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "summary",
                    "results"
                  ]
                }
              }
            }
          },

{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "name": "io.github.toolweather/toolweather",
  "version": "1.2.0",
  "title": "Toolweather",
  "description": "Toolweather suite: MCP server health (~2,000 servers), AI/dev API status (~40 providers), and model deprecations. One MCP endpoint.",
  "websiteUrl": "https://toolweather.pages.dev",
  "repository": {
    "url": "https://github.com/toolweather/toolweather",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://toolweather.toolweather.workers.dev/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Free API key (1,000 calls/day). Get one instantly: POST https://toolweather.toolweather.workers.dev/v1/keys or the get_api_key tool (no key needed).",
          "isRequired": true,
          "isSecret": true
        }
      ],
      "supportedProtocolVersions": [
        "2026-07-28",
        "2025-11-25",
        "2025-06-18",
        "2025-03-26"
      ]
    }
  ],
  "_meta": {
    "io.github.toolweather/links": {
      "openapi": "https://toolweather.toolweather.workers.dev/openapi.json",
      "llms_txt": "https://toolweather.pages.dev/llms.txt",
      "status_page": "https://toolweather.pages.dev",
      "get_key": "POST https://toolweather.toolweather.workers.dev/v1/keys",
      "upstream_api": "https://upstream.toolweather.workers.dev",
      "upstream_site": "https://upstream-api.pages.dev"
    },
    "io.github.toolweather/suite": [
      "mcp_health",
      "upstream_api_status"
    ],
    "io.github.toolweather/tools": [
      "check_mcp_server_health",
      "find_alternative_mcp_servers",
      "get_api_key",
      "watch_server",
      "list_watches",
      "unwatch_server",
      "check_api_status",
      "check_model_deprecation",
      "list_recent_api_changes",
      "list_providers",
      "get_digest"
    ],
    "io.github.toolweather/tool_aliases": {
      "is_safe_to_call": "check_mcp_server_health",
      "suggest_alternatives": "find_alternative_mcp_servers",
      "get_status": "check_api_status",
      "get_model": "check_model_deprecation",
      "get_changes": "list_recent_api_changes"
    },
    "io.github.toolweather/when_to_use": "Before adding/calling a third-party MCP server: check_mcp_server_health. Before calling an AI/dev API or after 5xx: check_api_status. Before hard-coding a model id: check_model_deprecation. Every result starts with a one-line summary, verdict, recommended_action, checked_at and freshness."
  }
}
